<?xml version="1.0"?>
<ruleset name="WAYT Recesso Online">
	<description>Coding standards per WAYT Recesso Online (WordPress + WooCommerce).</description>

	<file>.</file>

	<!-- Escludi tutto ciò che non è codice del plugin. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<!-- Standard di base. -->
	<rule ref="WordPress-Extra">
		<!-- La sintassi short array e' adottata coerentemente in tutto il
		     plugin (PHP 8.0+): scelta di stile del progetto, non un difetto. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>
	<rule ref="WordPress-Docs"/>

	<!-- Capability di WooCommerce note al progetto. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<!-- Il file principale e' l'entry-point del plugin (header + classe
	     bootstrap): non va rinominato in class-*.php. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>wayt-recesso-online.php</exclude-pattern>
	</rule>

	<!-- Internazionalizzazione: text domain del plugin. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wayt-recesso"/>
			</property>
		</properties>
	</rule>

	<!-- Prefissi globali per evitare collisioni. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wayt_recesso"/>
				<element value="WAYT_Recesso"/>
				<element value="WAYT_RECESSO"/>
			</property>
		</properties>
	</rule>

	<!-- Versioni minime supportate. -->
	<config name="minimum_wp_version" value="6.2"/>
	<config name="testVersion" value="8.0-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
